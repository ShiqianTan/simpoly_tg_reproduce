(* EMC: Script *)

(* Created by emc_setup.pl v4.1.5, March 30, 2024
   on Mon Sep 14 12:40:47 CST 2026 *)

(* define variables *)

variables	= {
  seed		-> 7,
  ntotal	-> 1944,
  fshape	-> 1,
  output	-> "system",
  field		-> "pcff/pcff",
  location1	-> "/opt/conda/envs/simpoly/lib/python3.12/site-packages/pyemc/emc/field/",

  nav		-> 0.6022141179,
  temperature	-> 533,
  radius	-> 5,
  nrelax	-> 100,
  weight_nonbond -> 0.0001,
  weight_bond	-> 0.0001,
  weight_focus	-> 1,
  cutoff	-> 9.5,
  charge_cutoff	-> 9.5,
  kappa		-> 4,

  density1	-> 0.9,
  lprevious	-> 0,
  lphase	-> 0,

  f_cluster_0	-> 1.0,

  chem_center_0	-> "*CC(C(=O)OC)*",
  chem_terminal_0 -> "H*",
  chem_terminal_1 -> "H*"
};

output		= {
  debug		-> false,
  exit		-> true,
  info		-> true,
  warning	-> true
};

(* define force field *)

field		= {
  id		-> pcff,
  mode		-> cff,
    name	-> {location1+field+".frc", location1+field+"_templates.dat"},
  compress	-> false
};

(* define groups *)

groups		= {
  group		-> {
    id		-> center_0, depth -> 8, chemistry -> chem_center_0,
    connects	-> {
      {source	-> $end1, destination -> {center_0, $end2}},
      {source	-> $end1, destination -> {terminal_0, $end1}},
      {source	-> $end2, destination -> {center_0, $end1}},
      {source	-> $end2, destination -> {terminal_1, $end1}}
    }
  },
  group		-> {
    id		-> terminal_0, depth -> 8, chemistry -> chem_terminal_0,
    connects	-> {
      {source	-> $end1, destination -> {center_0, $end1}}
    }
  },
  group		-> {
    id		-> terminal_1, depth -> 8, chemistry -> chem_terminal_1,
    connects	-> {
      {source	-> $end1, destination -> {center_0, $end2}}
    }
  }
};

field		= {
  mode		-> apply,
  check		-> {
    atomistic	-> true,
    charge	-> true
  },
  increment	-> warn,
  debug		-> false
};

(* determine simulation sizing *)

variables	= {

  (* lengths *)

  lg_center_0	-> nsites(center_0),
  lg_terminal_0	-> nsites(terminal_0),
  lg_terminal_1	-> nsites(terminal_1),
  norm_cluster_0 -> 1,

  l_cluster_0	-> (30*lg_center_0+lg_terminal_0+lg_terminal_1)*1/norm_cluster_0,

  (* masses *)

  mg_center_0	-> mass(center_0),
  mg_terminal_0	-> mass(terminal_0),
  mg_terminal_1	-> mass(terminal_1),

  norm_cluster_0 -> 1,

  m_cluster_0	-> (30*mg_center_0+mg_terminal_0+mg_terminal_1)*1/norm_cluster_0,

  (* mol fractions *)

  f_cluster_0	-> f_cluster_0*l_cluster_0,

  (* normalization *)

  norm		-> f_cluster_0,

  f_cluster_0	-> f_cluster_0/norm,

  (* sizing *)

  n_cluster_0	-> int(f_cluster_0*ntotal/l_cluster_0+0.5),


  (* system sizing *)

  ntotal	-> 0,
  mtotal	-> 0
};

(* define interactions *)

simulation	= {
  units		-> {
    permittivity -> 1,
    seed	-> seed
  },
  types		-> {
    coulomb	-> {
      pair	-> {active -> true, cutoff -> charge_cutoff}
    }
  }
};

(* clusters phase 1 *)

clusters	= {
  progress	-> none,
  polymer	-> {
    id		-> cluster_0, system -> main, type -> random,
    n		-> int(1*n_cluster_0/norm_cluster_0+0.5),
    groups	-> {center_0, terminal_0, terminal_1},
    weights	-> {1, 1, 1},
    nrepeat	-> {30, 1, 1}
  }
};

field		= {
  mode		-> apply,
  check		-> {
    atomistic	-> true,
    charge	-> true
  },
  increment	-> warn,
  debug		-> false
};

(* build phase 1 *)

types		= {
  cff		-> {
    pair	-> {active -> true, mode -> repulsive}
  }
};

variables	= {
  nphase1	-> ntotal()-ntotal,
  mphase1	-> mtotal()-mtotal,
  vphase1	-> mphase1/nav/density1,
  lbox		-> (vphase1/fshape)^(1/3),
  lphase1	-> fshape*lbox,
  lxx		-> lphase1,
  lyy		-> lbox,
  lzz		-> lbox,
  lzy		-> 0,
  lzx		-> 0,
  lyx		-> 0,
  lphase	-> lphase1,
  ntotal	-> nphase1,
  mtotal	-> mphase1,
  vtotal	-> vphase1
};

build		= {
  system	-> {
    id		-> main,
    split	-> false,
    geometry	-> {xx -> lxx, yy -> lyy, zz -> lzz,
		    zy -> lzy, zx -> lzx, yx -> lyx},
    temperature	-> temperature,
    flag	-> {charge -> true, geometry -> true, map -> true, pbc -> true}
  },
  select	-> {
    progress	-> list,
    frequency	-> 1,
    name	-> "error",
    order	-> random,
    cluster	-> {cluster_0},
    relax	-> {ncycles -> nrelax, radius -> radius},
    grow	-> {
      method	-> energetic,
      check	-> all,
      nbonded	-> 20,
      ntrials	-> 20,
      niterations -> 1000,
      theta	-> 0,
      weight	-> {
	bonded	-> weight_bond, nonbonded -> weight_nonbond,
	focus	-> weight_focus}
    }
  }
};

force		= {style -> none, message -> nkt};
force		= {style -> init, message -> nkt};

(* LAMMPS profile variables *)

variables	= {
  nl_cluster_0	-> nclusters(clusters -> cluster_0)
};

(* storage *)

put		= {name -> output, compress -> true};

lammps		= {name -> output, mode -> put, forcefield -> cff,
		   parameters -> true, types -> false, unwrap -> true,
		   charges -> true, ewald -> true};
