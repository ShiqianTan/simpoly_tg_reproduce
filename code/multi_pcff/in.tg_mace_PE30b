# MACE-OFF23 cooling scan PE30b, EMC cell (melt 2.5ps @ 0.5fs, 1250 steps/stage)
atom_style      atomic
atom_modify     map array sort 0 2.0
units           metal
newton          on
read_data       /home/tione/notebook/home/tanshiqian/simpoly_tg_repro/multi_pcff/PE30b/data.lmps
pair_style      mliap unified /home/tione/notebook/home/tanshiqian/simpoly_tg_repro/compare1944/MACE-OFF23_medium-mliap32_lammps.pt 0
pair_coeff      * * C H
mass 1 12.01115
mass 2 1.00797
neighbor        0.5 bin
neigh_modify    delay 50 every 2 check yes
thermo_style    custom step temp density vol press ke pe etotal spcpu
thermo_modify   flush yes
thermo          125
timestep        0.0005
fix fMOM all momentum 100 linear 1 1 1 angular
velocity all create 433.0 42 mom yes rot yes dist gaussian

# Minimize
min_style cg
minimize 1e-4 1e-6 1000 10000

# Melt at 700 K (NVT)
timestep        0.0005
fix melt all nvt temp 700.0 700.0 0.05
run 5000
unfix melt
timestep        0.0005

# Pre-equilibration at 433.0 K (NPT)
fix pre all npt temp 433.0 433.0 0.05 aniso 1.000 1.000 0.5
run 5000
unfix pre

