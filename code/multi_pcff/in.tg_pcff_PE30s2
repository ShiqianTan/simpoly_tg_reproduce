# PCFF cooling scan (SHORT protocol) PE30s2, EMC cell
atom_style      full
units           real
newton          on
read_data       /home/tione/notebook/home/tanshiqian/simpoly_tg_repro/multi_pcff/PE30s2/system.data
kspace_style    pppm 1e-4
include         /home/tione/notebook/home/tanshiqian/simpoly_tg_repro/multi_pcff/PE30s2/system.params
neighbor        1.5 bin
neigh_modify    delay 50 every 2 check yes
thermo_style    custom step temp density vol press ke pe etotal spcpu
thermo_modify   flush yes
thermo          125
timestep        0.5
fix fMOM all momentum 100 linear 1 1 1 angular
velocity all create 433.0 42 mom yes rot yes dist gaussian

# Minimize
min_style cg
minimize 1e-4 1e-6 1000 10000

# Melt at 700 K (NVT)
timestep        0.25
fix melt all nvt temp 700.0 700.0 50
run 10000
unfix melt
timestep        0.5

# Pre-equilibration at 433.0 K (NPT)
fix pre all npt temp 433.0 433.0 50 aniso 1.000 1.000 500
run 10000
unfix pre

