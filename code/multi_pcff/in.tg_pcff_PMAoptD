# PCFF cooling scan PMAoptD, EMC cell (melt 20.0ps @ 0.25fs, 20000 steps/stage)
atom_style      full
units           real
newton          on
read_data       /home/tione/notebook/home/tanshiqian/simpoly_tg_repro/multi_pcff/PMAoptD/system.data
kspace_style    pppm 1e-4
include         /home/tione/notebook/home/tanshiqian/simpoly_tg_repro/multi_pcff/PMAoptD/system.params
neighbor        1.5 bin
neigh_modify    delay 50 every 2 check yes
thermo_style    custom step temp density vol press ke pe etotal spcpu
thermo_modify   flush yes
thermo          125
timestep        0.5
fix fMOM all momentum 100 linear 1 1 1 angular
velocity all create 533.0 42 mom yes rot yes dist gaussian

# Minimize
min_style cg
minimize 1e-4 1e-6 1000 10000

# Melt at 700 K (NVT)
timestep        0.25
fix melt all nvt temp 700.0 700.0 50
run 80000
unfix melt
timestep        0.5

# Pre-equilibration at 533.0 K (NPT)
fix pre all npt temp 533.0 533.0 50 aniso 1.000 1.000 500
run 80000
unfix pre

