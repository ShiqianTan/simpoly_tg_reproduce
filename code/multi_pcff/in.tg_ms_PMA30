# MatterSim v1.0.0-1M cooling scan PMA30, EMC cell (melt 1.25ps @ 0.25fs, 1250 steps/stage)
atom_style      atomic
atom_modify     map array sort 0 2.0
units           metal
newton          on
read_data       /home/tione/notebook/home/tanshiqian/simpoly_tg_repro/multi_pcff/PMA30/data.lmps
pair_style      mliap unified /home/tione/notebook/home/tanshiqian/simpoly_tg_repro/compare1944/mattersim-v1.0.0-1M_mliap.pt
pair_coeff      * * C C C H O O
mass 1 12.01115
mass 2 12.01115
mass 3 12.01115
mass 4 1.00797
mass 5 15.9994
mass 6 15.9994
neighbor        0.5 bin
neigh_modify    delay 50 every 2 check yes
thermo_style    custom step temp density vol press ke pe etotal spcpu
thermo_modify   flush yes
thermo          125
timestep        0.0005
fix fMOM all momentum 100 linear 1 1 1 angular
velocity all create 533.0 42 mom yes rot yes dist gaussian

# Minimize
min_style cg
minimize 1e-4 1e-6 1000 10000

# Melt at 700 K (NVT)
timestep        0.00025
fix melt all nvt temp 700.0 700.0 0.05
run 5000
unfix melt
timestep        0.0005

# Pre-equilibration at 533.0 K (NPT)
fix pre all npt temp 533.0 533.0 0.05 aniso 1.000 1.000 0.5
run 5000
unfix pre

# Stage: cool_000_533K
fix cool_000_533K all npt temp 533 533 0.05 aniso 1.000 1.000 0.5
run 1250
unfix cool_000_533K

# Stage: cool_001_513K
fix cool_001_513K all npt temp 513 513 0.05 aniso 1.000 1.000 0.5
run 1250
unfix cool_001_513K

