# Short PCFF equilibration of the EMC-built 1944-atom PS cell (real units, full atom style)
atom_style      full
units           real
newton          on
read_data       small_emc/build/system.data
kspace_style    pppm 1e-4
include         small_emc/build/system.params
neighbor        1.5 bin
neigh_modify    delay 50 every 2 check yes
thermo_style    custom step temp density vol press ke pe ebond evdwl ecoul elong etotal spcpu
thermo_modify   flush yes
thermo          250
timestep        0.5
fix fMOM all momentum 100 linear 1 1 1 angular
velocity all create 533.0 42 mom yes rot yes dist gaussian

fix nvt all nvt temp 700 700 50
run 5000
unfix nvt

fix npt all npt temp 533 533 50 aniso 1.0 1.0 500
run 15000
write_data small_emc/small_ps_pcff_equil.data
