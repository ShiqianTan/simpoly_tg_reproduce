units           metal
atom_style      atomic
atom_modify     map array sort 0 2.0
newton          on
read_data       /home/tione/notebook/home/tanshiqian/simpoly_tg_repro/multi_pcff/PE30/data.lmps
pair_style      mliap unified /home/tione/notebook/home/tanshiqian/simpoly_tg_repro/compare1944/mattersim-v1.0.0-1M_mliap.pt
pair_coeff      * * C H
mass 1 12.01115
mass 2 1.00797
neighbor        0.5 bin
neigh_modify    delay 50 every 2 check yes
thermo_style    custom step temp density vol press pe
thermo          1
run 0
write_dump all custom compare1944/ms_forces.dump id type x y z fx fy fz
